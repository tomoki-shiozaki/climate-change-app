@startuml er
skinparam defaultFontName "Noto Sans CJK JP"

entity "ユーザー" as User {
  +id <<PK>>
  username <<UNIQUE>>
  email
  password
  name
}

entity "地域マスター" as Region {
  +id <<PK>>
  name
  code <<UNIQUE>>
}

entity "指標グループ" as IndicatorGroup {
  +id <<PK>>
  name <<UNIQUE>>
  description
}

entity "指標マスター" as Indicator {
  +id <<PK>>
  group_id <<FK>>
  name
  unit
  description
  data_source_name
  data_source_url
  metadata_url
  <<UNIQUE(group_id, name)>>
}

entity "気候データ" as ClimateData {
  +id <<PK>>
  region_id <<FK>>
  indicator_id <<FK>>
  year
  value
  updated_at
  <<UNIQUE(region_id, indicator_id, year)>>
}

IndicatorGroup ||--o{ Indicator : group_id

Region ||--o{ ClimateData : region_id
Indicator ||--o{ ClimateData : indicator_id

@enduml
